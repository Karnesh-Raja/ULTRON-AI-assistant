# Copy this file to .env.local and paste your Gemini API key below.
# Do not commit .env.local or expose this key in client-side code.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Local PostgreSQL. Keep these credentials only in the ignored .env.local file.
# URL-encode any special characters in the passwords.
DATABASE_URL=postgresql://ultron_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/ultron_memory
DATABASE_MIGRATION_URL=postgresql://ultron_migrator:REPLACE_WITH_MIGRATION_PASSWORD@localhost:5432/ultron_memory

# Optional: first model to try. If it is retired / out of free quota, ULTRON automatically
# falls back to gemini-3.5-flash -> gemini-3.5-flash-lite -> gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
